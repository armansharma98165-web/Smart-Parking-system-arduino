#define TRIG1 2
#define ECHO1 3

#define TRIG2 4
#define ECHO2 5

#define GREEN1 6
#define RED1   7

#define GREEN2 8
#define RED2   9

#define THRESHOLD 20

long getDistance(int trigPin, int echoPin)
{
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0)
  {
    return 999;
  }

  long distance = duration * 0.034 / 2;

  return distance;
}

void setup()
{
  Serial.begin(9600);

  pinMode(TRIG1, OUTPUT);
  pinMode(ECHO1, INPUT);

  pinMode(TRIG2, OUTPUT);
  pinMode(ECHO2, INPUT);

  pinMode(GREEN1, OUTPUT);
  pinMode(RED1, OUTPUT);

  pinMode(GREEN2, OUTPUT);
  pinMode(RED2, OUTPUT);

  digitalWrite(GREEN1, LOW);
  digitalWrite(RED1, LOW);

  digitalWrite(GREEN2, LOW);
  digitalWrite(RED2, LOW);
}

void loop()
{
  long distance1 = getDistance(TRIG1, ECHO1);
  delay(50);

  long distance2 = getDistance(TRIG2, ECHO2);

  bool occupied1 = distance1 <= THRESHOLD;
  bool occupied2 = distance2 <= THRESHOLD;

  // Slot 1
  if (occupied1)
  {
    digitalWrite(RED1, HIGH);
    digitalWrite(GREEN1, LOW);
  }
  else
  {
    digitalWrite(RED1, LOW);
    digitalWrite(GREEN1, HIGH);
  }

  // Slot 2
  if (occupied2)
  {
    digitalWrite(RED2, HIGH);
    digitalWrite(GREEN2, LOW);
  }
  else
  {
    digitalWrite(RED2, LOW);
    digitalWrite(GREEN2, HIGH);
  }

  int availableSlots = 2;

  if (occupied1)
    availableSlots--;

  if (occupied2)
    availableSlots--;

  Serial.print("Slot 1: ");
  Serial.print(occupied1 ? "OCCUPIED" : "AVAILABLE");

  Serial.print(" | Distance: ");
  Serial.print(distance1);
  Serial.print(" cm");

  Serial.print(" || Slot 2: ");
  Serial.print(occupied2 ? "OCCUPIED" : "AVAILABLE");

  Serial.print(" | Distance: ");
  Serial.print(distance2);
  Serial.print(" cm");

  Serial.print(" || Available Slots: ");
  Serial.println(availableSlots);

  delay(500);
}
